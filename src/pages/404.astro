---
import Layout from '../layouts/Layout.astro';
import {translations} from '../data/i18n';
const t=translations.es;
---
<Layout locale="es" path="404/" title={t.notFound} description={t.notFoundText} noindex><section class="page-heading"><div class="wrap"><p class="eyebrow">OpenXpand</p><h1>{t.notFound}</h1><p class="lead">{t.notFoundText}</p></div></section><div class="wrap section"><a class="button" href="/es/">{t.home}<span aria-hidden="true"> ↗</span></a></div></Layout>
