---
import Layout from '../layouts/Layout.astro';
import Catalog from '../components/Catalog.astro';
import Contact from '../components/Contact.astro';
import {locales,paths,catalog,type Locale} from '../data/catalog';
import {translations} from '../data/i18n';
export function getStaticPaths(){return locales.flatMap(locale=>paths.map(path=>({params:{route:`${locale}/${path}`.replace(/\/$/,'')},props:{locale,path}})));}
const {locale,path}=Astro.props as {locale:Locale;path:string};const t=translations[locale];
const api=catalog.find(a=>path===`apis/${a.id}/`);const isHome=path==='';const isDev=path==='developers/';const isOp=path==='operators/';const isCatalog=path==='apis/';const isContact=path.startsWith('contact/');const isDemo=path==='contact/demo/';const isPrivacy=path==='privacy/';const is404=path==='404/';
const title=isHome?t.hero:api?api.name:isDev?t.devTitle:isOp?t.platformTitle:isCatalog?t.apiTitle:isContact?(isDemo?t.demoTitle:t.requestTitle):isPrivacy?t.privacyTitle:t.notFound;
const description=api?api.copy[locale][0]:isDev?t.devIntro:isOp?t.platformIntro:isCatalog?t.apiIntro:isContact?t.metaContact:isPrivacy?t.metaPrivacy:t.metaHome;
const url=(s:string)=>`/${locale}/${s}`;
const closing=isHome||isDev||isOp||isCatalog||!!api;
---
<Layout locale={locale} path={path} title={title} description={description} noindex={is404}>
{isHome?<>
<section class="hero" aria-labelledby="hero-title"><div class="wrap hero-grid">
<div class="hero-copy"><p class="eyebrow">{t.eyebrow}</p><h1 id="hero-title">{t.hero}<span class="dot" aria-hidden="true">.</span></h1><p class="lead">{t.intro}</p><div class="actions"><a class="button peach" href={url('contact/apis/')}>{t.try}<span aria-hidden="true"> ↗</span></a><a class="button outline" href={url('contact/demo/')}>{t.demo}<span aria-hidden="true"> ↗</span></a></div><p class="small note">{t.tryNote}</p></div>
<div class="artifact"><p class="artifact-label">{t.heroCatalogLabel}</p><ul class="chips">{catalog.map(a=><li>{a.name}</li>)}</ul></div>
</div></section>
<section class="wrap section" id="audiences" aria-labelledby="audiences-title"><div class="section-intro"><p class="eyebrow">{t.audienceEyebrow}</p><h2 id="audiences-title">{t.audienceTitle}</h2><p class="lead">{t.audienceIntro}</p></div><div class="audience-grid">
<article class="audience-card"><img src="/assets/developers.webp" alt={t.devAlt} width="580" height="435" loading="lazy"/><div class="audience-body"><p class="eyebrow">{t.devAudience}</p><h3>{t.devTitle}</h3><p>{t.devIntro}</p><ul class="ticks">{t.devPoints.map(point=><li>{point}</li>)}</ul><div class="card-actions"><a class="button" href={url('contact/apis/')}>{t.try}<span aria-hidden="true"> ↗</span></a><a class="text-link" href={url('developers/')}>{t.devMore}<span aria-hidden="true"> ↗</span></a></div></div></article>
<article class="audience-card"><img src="/assets/operators.webp" alt={t.opAlt} width="580" height="435" loading="lazy"/><div class="audience-body"><p class="eyebrow">{t.opAudience}</p><h3>{t.opTitle}</h3><p>{t.opIntro}</p><ul class="ticks">{t.opPoints.map(point=><li>{point}</li>)}</ul><div class="card-actions"><a class="button" href={url('contact/demo/')}>{t.demo}<span aria-hidden="true"> ↗</span></a><a class="text-link" href={url('operators/')}>{t.more}<span aria-hidden="true"> ↗</span></a></div></div></article>
</div></section>
<section class="tint" id="capabilities" aria-labelledby="capabilities-title"><div class="wrap section"><div class="section-heading"><div class="section-intro"><p class="eyebrow">{t.catalog}</p><h2 id="capabilities-title">{t.apiTitle}</h2><p class="lead">{t.apiIntro}</p></div><a class="text-link" href={url('apis/')}>{t.explore}<span aria-hidden="true"> ↗</span></a></div><Catalog locale={locale} level={3} actions={false}/></div></section>
<section class="dark" id="about" aria-labelledby="about-title"><div class="wrap section narrow"><p class="eyebrow">OpenXpand</p><h2 id="about-title">{t.aboutTitle}</h2><p class="lead">{t.about}</p></div></section>
</>:<section class:list={['page-heading',api||isContact?'tint':'']}><div class="wrap"><a class="breadcrumb" href={url(api?'apis/':'')}>{api?t.back:t.home}</a><p class="eyebrow">{isDev?t.devAudience:isOp?t.opAudience:api?t.catalog:'OpenXpand'}</p><h1>{title}</h1><p class="lead">{is404?t.notFoundText:description}</p></div></section>}
{(isCatalog||isDev)&&<section class="wrap section"><Catalog locale={locale} level={2}/></section>}
{(isHome||isDev)&&<section class:list={[isDev&&'tint']} id="start" aria-labelledby="start-title"><div class="wrap section"><div class="section-intro"><p class="eyebrow">{t.stepsEyebrow}</p><h2 id="start-title">{t.accessTitle}</h2><p class="lead">{t.access}</p></div><ol class="steps">{t.steps.map(([n,heading,body])=><li><span class="number" aria-hidden="true">{n}</span><h3>{heading}</h3><p>{body}</p></li>)}</ol><a class="button" href={url('contact/apis/')}>{t.try}<span aria-hidden="true"> ↗</span></a></div></section>}
{isHome&&<section class="tint" id="trust" aria-labelledby="trust-title"><div class="wrap section"><div class="section-intro"><p class="eyebrow">{t.trustEyebrow}</p><h2 id="trust-title">{t.trustTitle}</h2><p class="lead">{t.trustIntro}</p></div><div class="trust-grid">{t.trustPoints.map(([heading,body])=><article><h3>{heading}</h3><p>{body}</p></article>)}</div><a class="text-link" href={url('privacy/')}>{t.privacyLink}</a></div></section>}
{isOp&&<><section class="wrap section split"><div><h2>{t.opTitle}</h2><p class="lead">{t.opIntro}</p><a class="button" href={url('contact/demo/')}>{t.demo}<span aria-hidden="true"> ↗</span></a></div><img src="/assets/operators.webp" width="580" height="435" alt={t.opAlt} fetchpriority="high"/></section><section class="tint"><div class="wrap section"><div class="capabilities">{t.capabilities.map(([heading,body])=><article><h2>{heading}</h2><p>{body}</p></article>)}</div><p class="lead">{t.demoDetail}</p><a class="button" href={url('contact/demo/')}>{t.demo}<span aria-hidden="true"> ↗</span></a></div></section></>}
{api&&<section class="wrap section detail-grid"><div><h2>{t.operations}</h2><ul class="pills">{api.operations.map(op=><li>{op}</li>)}</ul><h2>{t.useCase}</h2><p class="lead">{api.copy[locale][1]}</p><p>{t.responsible}</p></div><aside class="callout"><h2>{t.accessTitle}</h2><p>{t.access}</p><a class="button" href={url(`contact/apis/?api=${api.id}`)}>{t.try}<span aria-hidden="true"> ↗</span></a></aside></section>}
{isContact&&<section class="wrap section contact-grid"><div><h2>{isDemo?t.opTitle:t.accessTitle}</h2><p class="lead">{t.contactIntro}</p><p>{isDemo?t.demoDetail:t.access}</p><a href="mailto:info@openxpand.com">info@openxpand.com</a></div><Contact locale={locale} intent={isDemo?'demo':'apis'}/></section>}
{isPrivacy&&<section class="wrap section narrow"><p>{t.privacyIntro} {t.mailNotice}</p>{t.privacySections.map(([heading,body])=><section><h2>{heading}</h2><p>{body}</p></section>)}</section>}
{is404&&<div class="wrap section"><a class="button" href={url('')}>{t.home}<span aria-hidden="true"> ↗</span></a></div>}
{(isHome||isDev||isOp||api)&&<section class="wrap section faq" aria-labelledby="faq-title"><h2 id="faq-title">{t.faqTitle}</h2>{t.faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</section>}
{closing&&<section class="cta-band" aria-labelledby="cta-title"><div class="wrap section narrow"><h2 id="cta-title">{t.ctaTitle}</h2><p class="lead">{t.ctaText}</p><div class="actions"><a class="button peach" href={url('contact/apis/')}>{t.try}<span aria-hidden="true"> ↗</span></a><a class="button outline" href={url('contact/demo/')}>{t.demo}<span aria-hidden="true"> ↗</span></a></div><a class="mail" href="mailto:info@openxpand.com">info@openxpand.com</a></div></section>}
</Layout>
