---
import {catalog,type Locale} from '../data/catalog';
import {translations} from '../data/i18n';
const {locale}=Astro.props as {locale:Locale}; const t=translations[locale];
---
<div class="catalog-grid">{catalog.map((api,i)=><article class="api-card"><span class="number" aria-hidden="true">{String(i+1).padStart(2,'0')} ↗</span><h3><a href={`/${locale}/apis/${api.id}/`}>{api.name}</a></h3><p>{api.copy[locale][0]}</p><span class="operations">{api.operations.join(' / ')}</span><a class="text-link" href={`/${locale}/contact/apis/?api=${api.id}`}>{t.try}<span aria-hidden="true"> ↗</span></a></article>)}</div>
