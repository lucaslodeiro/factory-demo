---
import {catalog,type Locale,type Intent} from '../data/catalog';
import {translations} from '../data/i18n';
const {locale,intent}=Astro.props as {locale:Locale;intent:Intent}; const t=translations[locale];
const key=import.meta.env.PUBLIC_TURNSTILE_SITE_KEY||'';
---
<form id="contact" method="post" action="/api/contact" novalidate data-locale={locale} data-intent={intent} data-sitekey={key} data-copy={JSON.stringify({name:t.name,email:t.email,company:t.company,message:t.message,api:t.api,language:t.language,intent:t.intent,intentLabel:intent==='apis'?t.requestTitle:t.demoTitle,mailDraft:t.mailDraft,sending:t.sending,submit:t.submit,success:t.success,error:t.error,invalid:t.invalid,fieldError:t.fieldError,emailError:t.emailError,spamError:t.spamError})}>
<p class="small">{t.required}</p><p class="small">{t.mailNotice}</p>
{(['name','email','company'] as const).map(name=><div class="field"><label for={name}>{t[name]}</label><input id={name} name={name} type={name==='email'?'email':'text'} autocomplete={{name:'name',email:'email',company:'organization'}[name]} required maxlength={{name:100,email:254,company:160}[name]} aria-describedby={`${name}-error`}/><span class="field-error" id={`${name}-error`}></span></div>)}
<div class="field"><label for="api">{t.api} <span class="small">({t.optional})</span></label><select id="api" name="api"><option value="">{t.none}</option>{catalog.map(a=><option value={a.id}>{a.name}</option>)}</select></div>
<div class="field"><label for="message">{t.message}</label><textarea id="message" name="message" required rows="5" maxlength="5000" aria-describedby="message-error"></textarea><span id="message-error" class="field-error"></span></div>
<div class="trap" aria-hidden="true"><label for="website">{t.honeypot}</label><input id="website" name="website" tabindex="-1" autocomplete="off"/></div>
<div id="security" role="group" aria-label={t.security}></div><p class="small">{t.unavailable}</p><p class="small">{t.notice} <a href={`/${locale}/privacy/`}>{t.privacyLink}</a></p><button class="button" type="submit">{t.submit} <span aria-hidden="true">↗</span></button><p id="status" role="status" aria-live="polite" tabindex="-1"></p><a id="mail-fallback" hidden>{t.mailOpen}</a><noscript><p>{t.noJs}</p></noscript></form>
<script>import '../scripts/contact';</script>
