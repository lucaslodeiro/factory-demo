---
import { content, languages, paths, apiNames, type Language } from '../data/content';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '../styles/global.css';
import regularFont from '@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url';
import mediumFont from '@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = content[lang];
const ids = ['developers', 'telcos', 'apis', 'platform', 'contact'];
const base = Astro.site!;
const url = new URL(paths[lang], base).href;
const mail = (i: number) => `mailto:info@openxpand.com?subject=${encodeURIComponent(t.subjects[i])}`;
const schema = { '@context': 'https://schema.org', '@graph': [{ '@type': 'Organization', '@id': `${base}#organization`, name: 'OpenXpand', url: base.href, logo: new URL('/assets/logo.svg', base).href, email: 'info@openxpand.com' }, { '@type': 'WebSite', '@id': `${base}#website`, name: 'OpenXpand', url: base.href, inLanguage: languages, publisher: { '@id': `${base}#organization` } }] };
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
<link rel="preload" href={regularFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={mediumFont} as="font" type="font/woff2" crossorigin />
<title>{t.title}</title><meta name="description" content={t.description} />
<link rel="canonical" href={url} />
{languages.map(l => <link rel="alternate" hreflang={l} href={new URL(paths[l], base).href} />)}
<link rel="alternate" hreflang="x-default" href={base.href} />
<meta property="og:type" content="website" /><meta property="og:site_name" content="OpenXpand" />
<meta property="og:title" content={t.title} /><meta property="og:description" content={t.description} /><meta property="og:url" content={url} /><meta property="og:locale" content={{es:'es_ES',en:'en_US',pt:'pt_PT'}[lang]} />
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
<a class="skip" href="#main">{t.skip}</a>
<header class="site-header"><a href={paths[lang]} aria-label="OpenXpand"><img src="/assets/logo.svg" alt="OpenXpand" width="176" height="30" /></a>
<nav aria-label={t.nav.join(', ')} class="primary-nav">{ids.map((id,i) => <a href={`#${id}`}>{t.nav[i]}</a>)}</nav>
<nav aria-label={t.language} class="languages">{languages.map(l => <a href={paths[l]} lang={l} hreflang={l} data-language aria-label={{es:'Español',en:'English',pt:'Português'}[l]} aria-current={l===lang?'page':undefined}>{l.toUpperCase()}</a>)}</nav></header>
<main id="main">
<section class="hero" aria-labelledby="hero-title"><div class="hero-inner"><p class="eyebrow">{t.eyebrow}</p><h1 id="hero-title">{t.hero}</h1><p class="lead">{t.intro}</p><div class="actions"><a class="button coral" href={mail(1)}>{t.access}<span aria-hidden="true"> ↗</span></a><a class="button outline" href={mail(0)}>{t.demo}<span aria-hidden="true"> ↗</span></a></div><a class="text-link" href="#developers">{t.nav[0]} <span aria-hidden="true">↓</span></a></div><div class="network" aria-hidden="true"><div class="orbit one"></div><div class="orbit two"></div><div class="orbit three"></div><span class="network-mark">X</span><span class="node a"></span><span class="node b"></span><span class="node c"></span></div><div class="bridge">{t.bridge.map((label,i) => <span>{i>0 && <b aria-hidden="true">↗</b>}{label}</span>)}</div></section>
<section class="section audiences"><p class="eyebrow">{t.audience}</p><div class="audience-grid">{[0,1].map(i=><article id={i===0?'developers':'telcos'} class:list={['audience-card',i===0?'developer':'telco']}><p class="label">0{i+1} / {t.nav[i]}</p><h2>{i===0?t.devTitle:t.telcoTitle}</h2><p>{i===0?t.devBody:t.telcoBody}</p><ul>{(i===0?t.devPoints:t.telcoPoints).map(p=><li>{p}</li>)}</ul><a class="text-link" href={mail(i===0?1:0)}>{i===0?t.access:t.demo} <span aria-hidden="true">↗</span></a></article>)}</div></section>
<section id="apis" class="section portfolio"><p class="eyebrow">03 / {t.nav[2]}</p><div class="section-heading"><h2>{t.portfolio}</h2><p>{t.portfolioIntro}</p></div><div class="api-grid">{[[0,6],[6,10],[10,11]].map(([start,end],i)=><article class="api-card"><span class="api-icon" aria-hidden="true">{['◎','⌁','◇'][i]}</span><h3>{t.categories[i]}</h3><p>{t.categoryDescriptions[i]}</p><ul>{apiNames.slice(start,end).map(name=><li>{name}<span aria-hidden="true">↗</span></li>)}</ul></article>)}</div></section>
<section id="platform" class="section platform"><p class="eyebrow">04 / {t.nav[3]}</p><div class="section-heading"><h2>{t.platform}</h2><p>{t.platformIntro}</p></div><div class="capabilities">{t.capabilities.map(([title,body],i)=><article><span class="number">0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<section class="section purpose"><p class="eyebrow">{t.about}</p><h2>{t.purpose}</h2><p>{t.contactBody}</p></section>
<section id="contact" class="section contact"><p class="eyebrow">05 / {t.nav[4]}</p><h2>{t.contact}</h2><div class="actions"><a class="button coral" href={mail(1)}>{t.access} ↗</a><a class="button outline" href={mail(0)}>{t.demo} ↗</a></div><p class="email-note">{t.emailNote}</p><a class="email" href="mailto:info@openxpand.com">info@openxpand.com</a></section>
</main>
<footer><a href={paths[lang]} aria-label="OpenXpand"><img src="/assets/logo.svg" alt="OpenXpand" width="150" height="25" loading="lazy" /></a><p>{t.footer}</p><span>© {new Date().getFullYear()} OpenXpand</span></footer>
<script>
const known = new Set(['main','developers','telcos','apis','platform','contact']);
function updateLanguages() {
 const hash = window.location.hash;
 document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(link => { link.hash = known.has(hash.slice(1)) ? hash : ''; });
}
updateLanguages();
window.addEventListener('hashchange', updateLanguages);
</script>
</body></html>
