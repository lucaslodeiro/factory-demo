---
import {locales,type Locale} from '../data/catalog';
import {translations} from '../data/i18n';
import '../styles/global.css';
interface Props {locale:Locale; path:string; title:string; description:string; noindex?:boolean}
const {locale,path,title,description,noindex=false}=Astro.props;
const t=translations[locale];const origin='https://openxpand.com';const canonical=`${origin}/${locale}/${path}`;
const preview=import.meta.env.PUBLIC_SITE_ENV!=='production';
const org={'@context':'https://schema.org','@type':'Organization',name:'OpenXpand',url:origin,logo:`${origin}/assets/logo.svg`,email:'info@openxpand.com'};
const crumbs={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:t.home,item:`${origin}/${locale}/`},...(path?[{'@type':'ListItem',position:2,name:title,item:canonical}]:[])]};
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | OpenXpand</title><meta name="description" content={description}/><meta name="robots" content={noindex||preview?'noindex, nofollow':'index, follow'}/><link rel="canonical" href={canonical}/>{locales.map(l=><link rel="alternate" hreflang={l} href={`${origin}/${l}/${path}`}/>)}<link rel="alternate" hreflang="x-default" href={`${origin}/es/${path}`}/><link rel="icon" type="image/svg+xml" href="/assets/favicon.svg"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={`${origin}/assets/operators.webp`}/><meta property="og:locale" content={{es:'es_ES',en:'en_US',pt:'pt_BR'}[locale]}/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(org)}/><script type="application/ld+json" set:html={JSON.stringify(crumbs)}/></head>
<body><a class="skip" href="#main">{t.skip}</a><header><div class="nav-shell"><a class="brand" href={`/${locale}/`} aria-label={t.brandAlt}><img src="/assets/logo.svg" width="170" height="39" alt="OpenXpand"/></a><nav class="main-nav" aria-label={t.navMain}>{([['apis/',t.catalog],['developers/',t.developers],['operators/',t.operators]] as const).map(([target,label])=><a href={`/${locale}/${target}`} aria-current={path===target?'page':undefined}>{label}</a>)}</nav><nav class="languages" aria-label={t.language}>{locales.map(l=><a href={`/${l}/${path}`} lang={l} hreflang={l} aria-current={locale===l?'page':undefined}>{l.toUpperCase()}</a>)}</nav><a class="button peach nav-cta" href={`/${locale}/contact/apis/`}>{t.try}<span aria-hidden="true"> ↗</span></a></div></header>
<main id="main"><slot/></main><footer><div class="footer-grid"><div class="footer-brand"><a href={`/${locale}/`} aria-label={t.brandAlt}><img src="/assets/logo.svg" width="170" height="39" alt="OpenXpand" loading="lazy"/></a><p>{t.footer}</p></div>
<nav aria-label={t.footerProduct}><p class="footer-title">{t.footerProduct}</p><a href={`/${locale}/apis/`}>{t.catalog}</a><a href={`/${locale}/contact/apis/`}>{t.try}</a></nav>
<nav aria-label={t.footerAudiences}><p class="footer-title">{t.footerAudiences}</p><a href={`/${locale}/developers/`}>{t.developers}</a><a href={`/${locale}/operators/`}>{t.operators}</a></nav>
<nav aria-label={t.footerContact}><p class="footer-title">{t.footerContact}</p><a href={`/${locale}/contact/demo/`}>{t.demo}</a><a href="mailto:info@openxpand.com">info@openxpand.com</a></nav>
<div><p class="footer-title">{t.footerLegal}</p><a href={`/${locale}/privacy/`}>{t.privacy}</a><p class="footer-title">{t.footerLanguages}</p><nav class="footer-languages" aria-label={t.footerLanguages}>{locales.map(l=><a href={`/${l}/${path}`} lang={l} hreflang={l} aria-current={locale===l?'page':undefined}>{l.toUpperCase()}</a>)}</nav></div></div><p class="copyright">© {new Date().getFullYear()} {t.rights}</p></footer></body></html>
